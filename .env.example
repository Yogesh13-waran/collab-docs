# ==========================================
# CollabDocs Backend API - Environment Config
# ==========================================

# Secret Key (Do not commit real production keys to version control)
SECRET_KEY=django-insecure-collabdocs-production-grade-secret-key-replace-me

# Debug Mode
DEBUG=True

# Allowed Hosts (comma-separated)
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Engine Selection:
# Production/Evaluation default: django.db.backends.postgresql
# Development fallback: django.db.backends.sqlite3
DB_ENGINE=django.db.backends.postgresql

# PostgreSQL Credentials (required when DB_ENGINE=django.db.backends.postgresql)
DB_NAME=collabdocs_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# SQLite DB Path (used when DB_ENGINE=django.db.backends.sqlite3)
SQLITE_DB_NAME=db.sqlite3

